foreach(file routes_2023-04-16.json collection_schedule.csv route_statistics.csv report.json)
    if(NOT EXISTS "${OUT}/${file}")
        message(FATAL_ERROR "${OUT}/${file} was not written")
    endif()
endforeach()
file(READ "${OUT}/report.json" report)
string(JSON first_phase GET "${report}" calls 0 step)
if(NOT first_phase STREQUAL "rolling")
    message(FATAL_ERROR "report.json does not record the rolling call")
endif()
