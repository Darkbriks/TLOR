---
/**
 * Liara Engine — the sidebar, with a header saying what it is the sidebar of.
 *
 * A copy of @astrojs/starlight 0.41.10's `components/Sidebar.astro` with one
 * block added above the navigation.
 */
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;

const base = import.meta.env.BASE_URL;

const note = 'in development';
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<style>
    .liara-sidebar-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--liara-space-1) var(--liara-space-2);
        margin-block-end: var(--liara-space-4);
        padding-block-end: var(--liara-space-3);
        border-block-end: var(--liara-border-width-default) solid var(--liara-border-default);
    }

    .liara-sidebar-head__module {
        min-width: 0;
        color: var(--liara-text-primary);
        font-family: var(--liara-font-sans);
        font-size: var(--liara-text-base);
        font-weight: var(--liara-weight-bold);
        line-height: var(--liara-leading-snug);
        text-decoration: none;
    }

    .liara-sidebar-head__module:hover {
        color: var(--liara-text-link);
    }

    .liara-sidebar-head__version {
        display: flex;
        align-items: baseline;
        gap: var(--liara-space-2);
        margin: 0;
        min-width: 0;
    }

    .liara-sidebar-head__tag {
        padding: 0.05em 0.5em;
        border: var(--liara-border-width-default) solid var(--liara-brand-primary);
        border-radius: var(--liara-radius-pill);
        background: var(--liara-brand-primary-soft);
        color: var(--liara-brand-primary-dark);
        font-family: var(--liara-font-mono);
        font-size: var(--liara-text-xs);
        white-space: nowrap;
    }

    .liara-sidebar-head__note {
        color: var(--liara-text-tertiary);
        font-size: var(--liara-text-xs);
    }
</style>
